# FERN deployment configuration.
#
# Copy to deploy/.env and fill in the values. Both compose files read this file
# via `env_file: ../.env`, so a single copy covers validator + Bracken.

# Validator hint(s) baked into the Bracken JS at build time. Comma- or
# space-separated. These pre-fill the validator field for group creation and
# provide discovery endpoints when joining. They are starting points only;
# the authoritative validator set comes from verified group history and changes
# through committed `validator_update` events. Supply 1-3 endpoints for a
# unanimous development/test group, or exactly 3f+1 endpoints for standard BFT.
# Examples:
#   VITE_VALIDATOR_URL=wss://validator.example.com
#   VITE_VALIDATOR_URL=wss://validator1.example.com,wss://validator2.example.com
VITE_VALIDATOR_URL=

# Host path for the validator's persistent data (config.json, validator.db, and
# validator.key). Relative paths are resolved from deploy/validator/. Use a
# backed-up local volume in production and make it writable by UID/GID 1000:1000.
FERN_DATA_DIR=./data
